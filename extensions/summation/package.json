{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "summation",
  "version": "1.0.1",
  "title": "Summation - Sum Calculator",
  "description": "Calculate the sum of a list of numbers in the selected text or clipboard.",
  "icon": "summation-icon.png",
  "author": "monvelasquez",
  "categories": [
    "Finance",
    "Productivity"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Summation",
      "subtitle": "Calculate Total",
      "description": "Calculate the sum of a list of numbers in the selected text or clipboard.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.102.2",
    "@raycast/utils": "^2.2.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "18.8.3",
    "@types/react": "18.0.9",
    "eslint": "^7.32.0",
    "prettier": "^2.5.1",
    "typescript": "^4.4.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "prettier": "prettier -c -w **/*.tsx",
    "publish": "npx @raycast/api@latest publish"
  }
}